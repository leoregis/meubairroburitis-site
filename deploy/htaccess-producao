# taxonomia antiga do blog (categoria/tag do WordPress), sem
# correspondência 1:1 possível -- genérico pro índice de notícias
RewriteRule ^category/ /noticias? [R=301,L]
RewriteRule ^tag/ /noticias? [R=301,L]
RewriteRule ^blog/post-category/ /noticias? [R=301,L]
