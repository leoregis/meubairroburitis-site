# vinha escolhendo a com barra por conta dos links antigos. Fica DEPOIS
# dos redirects legados (que aceitam /? no fim) pra /places/x/ continuar
# com um salto só. Não toca na raiz, em /guia/ (app à parte), nas pastas
# internas de release nem em diretório físico real.
RewriteCond %{REQUEST_URI} !^/(guia|\.well-known|_current|_old_|_release_)(/|$)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+)/$ /$1 [R=301,L]

# Se o arquivo existe direto na raiz do public_html (fora de _current/,
