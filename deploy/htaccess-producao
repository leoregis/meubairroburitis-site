# Fase 7b -- 404 real para slugs inválidos sob /empresas/, /prestadores/,
# /noticias/ e /loja/ (ver regra de fallback modificada mais abaixo).
# Aponta pra uma página de verdade, pré-renderizada com conteúdo real no
# HTML (app/pages/pagina-nao-encontrada.vue) -- NÃO pro 404.html
# genérico que o Nitro gera sozinho, que é só uma casca client-only
# vazia (mesmo mecanismo do 200.html, de propósito, pra servir de
# fallback genérico sem conteúdo específico "vazando" antes da
# hidratação -- não serve pra isso aqui).
# Escopo global do arquivo -- cascateia por padrão pra /guia/ também
# (Apache herda ErrorDocument do .htaccess pai salvo se o filho definir
# o próprio), mas /guia/.htaccess sempre resolve pra /guia/index.html
# antes de qualquer 404 acontecer (ver RewriteRule . /guia/index.html
# [L] lá) -- só afetaria um asset estático que realmente não existe
# dentro de /guia/assets/, cenário que já seria um erro hoje.
ErrorDocument 404 /_current/pagina-nao-encontrada/index.html

# 🔒 bloqueio explicito do backup do WordPress -- NUNCA deve ser acessivel
# pela web. Precisa vir ANTES de qualquer outra regra: a regra abaixo que
# serve "arquivo que existe direto na raiz" (pensada só pra coisas tipo
# verificacao do Google) tambem batia em qualquer arquivo real dentro
# dessa pasta -- inclusive os .php, que chegavam a EXECUTAR (WordPress
# real rodando, achado num teste de seguranca real).
RewriteRule ^wordpress_backup_2026/ - [F,L]

# og:image das noticias (29/set): o IPX gera JPEG mas o arquivo mantem o
# nome/extensao da capa original (.png, do Storage), entao o Apache servia
# "image/png" com conteudo JPEG. Navegador e WhatsApp toleram; outros
# crawlers de preview podem nao tolerar. Forca image/jpeg pra tudo gerado
# com f_jpeg.
# So casa na SEGUNDA passada (/_current/_ipx/...), depois que a regra
# generica mais abaixo reescreveu /_ipx/... pra /_current/...: a doc do
# mod_rewrite avisa que, em .htaccess, o tipo do flag T se perde se a
# mesma regra faz redirect interno -- por isso "-" como substituicao e sem
# [L]. Se por algum motivo nao casar, nada muda (continua como hoje).
RewriteCond %{REQUEST_URI} ^/_current/_ipx/[^/]*f_jpeg
RewriteRule ^ - [T=image/jpeg]

