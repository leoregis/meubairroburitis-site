RewriteCond %{REQUEST_URI} !^/_current/
RewriteCond %{REQUEST_URI} !^/_old_
RewriteCond %{REQUEST_URI} !^/_release_
RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI} -f
RewriteRule ^ - [L]

