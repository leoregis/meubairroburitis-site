# decisão do Leo sem evidência forte no Wayback -- tratamento genérico
RewriteRule ^lugar/?$ /noticias [R=301,L]

# noticias/categoria/guias -- existe um middleware em
# noticias/categoria/[id].vue que já faz esse redirect (301 pra
# /conteudo, hub próprio de "Guias", pra evitar duas URLs mostrando o
# mesmo conteúdo), mas só funciona depois que o usuário já está no
# site (client-side router) -- "guias" não é categoria real enumerada
# no build estático, então a página nunca é pré-renderizada e o
# acesso direto (primeira visita, é o que o Google rastreia) cai em
# 404 puro em vez do redirect. Regra aqui cobre exatamente esse caso;
# o middleware do Nuxt continua existindo, não foi removido.
RewriteRule ^noticias/categoria/guias/?$ /conteudo [R=301,L]

# Se o arquivo existe direto na raiz do public_html (fora de _current/,
# ex: verificacao de propriedade do Google, algum arquivo herdado do
# hosting), serve ele como esta -- sem redirecionar pro site novo.
RewriteCond %{REQUEST_URI} !^/guia/
RewriteCond %{REQUEST_URI} !^/\.well-known/
RewriteCond %{REQUEST_URI} !^/_current/
RewriteCond %{REQUEST_URI} !^/_old_
RewriteCond %{REQUEST_URI} !^/_release_
RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI} -f
RewriteRule ^ - [L]

# existe um arquivo real dentro de _current/ pra esse caminho exato?
# (assets: /_nuxt/xxx.js, /robots.txt, etc.)
RewriteCond %{REQUEST_URI} !^/guia/
RewriteCond %{REQUEST_URI} !^/\.well-known/
RewriteCond %{REQUEST_URI} !^/_current/
RewriteCond %{REQUEST_URI} !^/_old_
RewriteCond %{REQUEST_URI} !^/_release_
RewriteCond %{DOCUMENT_ROOT}/_current%{REQUEST_URI} -f
RewriteRule ^(.*)$ /_current/$1 [L]

# ou existe como pagina pre-renderizada (pasta/index.html)? cobre tanto
# "/loja" quanto "/loja/" apontando pro mesmo arquivo real -- sem isso,
# toda pagina prerenderizada (inclusive a home, "/") cairia no shell
# client-only em vez do HTML real (perderia SEO/first paint).
RewriteCond %{REQUEST_URI} !^/guia/
RewriteCond %{REQUEST_URI} !^/\.well-known/
RewriteCond %{REQUEST_URI} !^/_current/
RewriteCond %{REQUEST_URI} !^/_old_
RewriteCond %{REQUEST_URI} !^/_release_
RewriteCond %{DOCUMENT_ROOT}/_current%{REQUEST_URI}/index.html -f
RewriteRule ^(.*)$ /_current/$1/index.html [L]

# senao: shell client-only (200.html) SÓ pras rotas que não têm HTML
# pré-gerado de propósito -- as mesmas marcadas com prerender:false em
# routeRules no nuxt.config.ts: /carrinho, /pedido/[id] e /admin/*. O Vue
# Router assume dali. Qualquer outro caminho que chegou até aqui não existe
# (as 3 regras acima já teriam achado o arquivo) e cai no 404 nativo do
# Apache, que serve a página de erro real (ErrorDocument 404 no topo).
#
# Até 30/set era o contrário (tudo ia pro shell com 200, exceto
# /empresas/, /prestadores/, /noticias/ e /loja/, excluídos na Fase 7b):
# caminho inexistente fora desses 4 prefixos era soft-404 (HTTP 200,
# título vazio, index,follow). ATENÇÃO: página nova só client-side
# (prerender:false) precisa entrar nesta lista, senão dá 404 no acesso
# direto.
RewriteCond %{REQUEST_URI} ^/(carrinho/?$|pedido/|admin(/|$))
RewriteRule ^ /_current/200.html [L]
