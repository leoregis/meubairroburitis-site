# toda pagina prerenderizada (inclusive a home, "/") cairia no shell
# client-only em vez do HTML real (perderia SEO/first paint).
RewriteCond %{REQUEST_URI} !^/guia/
RewriteCond %{REQUEST_URI} !^/\.well-known/
RewriteCond %{REQUEST_URI} !^/_current/
RewriteCond %{REQUEST_URI} !^/_old_
RewriteCond %{REQUEST_URI} !^/_release_
RewriteCond %{DOCUMENT_ROOT}/_current%{REQUEST_URI}/index.html -f
RewriteRule ^(.*)$ /_current/$1/index.html [L]

