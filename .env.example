# Projeto Supabase SEPARADO do app do bairro (meubairro-app)
NUXT_PUBLIC_SUPABASE_URL=
NUXT_PUBLIC_SUPABASE_ANON_KEY=

# Fase 4 -- leitura pública (anon) do projeto Supabase do meubairro-app,
# só pras RPCs de SEO buscar_empresa_publica_seo/buscar_prestador_publico_seo
# (páginas /empresas/[slug] e /prestadores/[slug]). Chave anon pública,
# não é segredo -- mesma natureza da NUXT_PUBLIC_SUPABASE_ANON_KEY acima.
NUXT_PUBLIC_MEUBAIRRO_APP_SUPABASE_URL=
NUXT_PUBLIC_MEUBAIRRO_APP_SUPABASE_ANON_KEY=

# Mercado Pago — chave PÚBLICA (não é segredo, usada só pra tokenizar
# cartão no navegador via Card Payment Brick).
NUXT_PUBLIC_MP_PUBLIC_KEY=

# Estes NÃO vão no .env do site (que só roda no browser/build) — são
# secrets das edge functions, configurados via `supabase secrets set`:
#   MP_ACCESS_TOKEN=...          (access token privado do Mercado Pago)
#   MP_WEBHOOK_SECRET=...        (segredo de assinatura do webhook, painel MP)
#   RESEND_API_KEY=...           (e-mail transacional pós-pagamento — resend.com)
#   EMAIL_REMETENTE=...          (opcional; default "Meu Bairro Buritis <pedidos@meubairroburitis.com.br>"
#                                 — exige domínio verificado no Resend; até lá, usar
#                                 "onboarding@resend.dev" pra testar)
#   EMAIL_NOTIFICACAO_VENDA=...  (opcional; default contato@meubairroburitis.com.br)
#   SITE_URL=...                 (opcional; default https://meubairroburitis.com.br — usado
#                                 no link do e-mail de aviso de venda pro /admin/vendas)
